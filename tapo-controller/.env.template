# Tailscale sidecar.
CONF_TS_KEY=
CONF_TS_TAG=tapo
CONF_HOSTNAME=tapo

# TP-Link cloud account credentials (the same ones you use in the Tapo app).
# Required: the P115 does local control but authenticates against these.
# They are never sent to TP-Link by this app.
CONF_TAPO_USERNAME=
CONF_TAPO_PASSWORD=

# Comma-separated plug IPs, e.g. 192.168.1.50,192.168.1.51
# Required. Broadcast discovery cannot work from inside the sidecar's network
# namespace, so there is no fallback — every plug must be listed here, and each
# one wants a DHCP reservation so its address stays put.
# Plugs listed in servers.json are added automatically.
CONF_TAPO_HOSTS=

# Optional HTTP basic auth for the UI. Leave blank to disable — Tailscale is
# already doing the access control, so this is defence in depth, not the lock.
CONF_WEB_USERNAME=
CONF_WEB_PASSWORD=
